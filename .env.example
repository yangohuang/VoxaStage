# Source with: set -a; source .env; set +a
# Endpoints below are separate model workers; bot.py does not load their weights.
PIPECAT_ASR_URL=http://127.0.0.1:18315
PIPECAT_ASR_MODEL=Qwen3-ASR-0.6B
PIPECAT_LLM_URL=http://127.0.0.1:18311
PIPECAT_TTS_URL=http://127.0.0.1:19006
PIPECAT_AVATAR_URL=ws://127.0.0.1:12544/v1/stream
PIPECAT_AVATAR_PROVIDER=streamingtalker
# FlashHead URL must implement our version-1 bridge protocol (AVATAR-PROTOCOL.md).
# Leave empty until the corresponding real worker has been deployed.
PIPECAT_FLASHHEAD_URL=
# DINet uses the native audio WebSocket API; select your deployed character.
# Example: ws://127.0.0.1:19003/api/ws/live_video/<character_id>
PIPECAT_DINET_URL=
# Optional end-to-end dialogue worker, independent of avatar provider.
# Leave empty until omni-server/worker.py has loaded a real MiniCPM model.
PIPECAT_MINICPM_URL=
PIPECAT_DIALOGUE_BACKEND=cascade
# Set an authorized voice ID returned by /api/tts/list; empty uses its first ID.
PIPECAT_SPEAKER_ID=
# Character voices: StreamingTalker/DINet use male, FlashHead uses female.
PIPECAT_MALE_SPEAKER_ID=pipecat_male
PIPECAT_FEMALE_SPEAKER_ID=female11
# Optional ASCII technical terms; empty keeps ASR's original decoding.
PIPECAT_ASR_CONTEXT=
# Explicit opt-in compatibility APIs. Local remains the default.
PIPECAT_ASR_MODE=local
PIPECAT_LLM_MODE=local
PIPECAT_ASR_API_BASE=
PIPECAT_ASR_API_MODEL=
PIPECAT_ASR_API_KEY=
PIPECAT_LLM_API_BASE=
PIPECAT_LLM_API_MODEL=
PIPECAT_LLM_API_KEY=
PIPECAT_LLM_TOKEN_FIELD=max_tokens
PIPECAT_VAD_STOP_SECS=0.6
PIPECAT_TURN_WAIT_SECS=0.5
NLTK_DATA=.venv/nltk_data
NUMBA_CACHE_DIR=runtime/numba-cache
OMP_NUM_THREADS=2
