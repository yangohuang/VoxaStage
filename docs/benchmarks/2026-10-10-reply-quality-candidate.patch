diff --git a/omni-server/test_reply_style.py b/omni-server/test_reply_style.py
new file mode 100644
index 0000000..859abe4
--- /dev/null
+++ b/omni-server/test_reply_style.py
@@ -0,0 +1,42 @@
+import unittest
+from contextlib import nullcontext
+from types import SimpleNamespace
+import httpx
+from worker import MiniCPMEngine, SYSTEM, create_app
+
+
+class ReplyStyleTests(unittest.IsolatedAsyncioTestCase):
+    def capture(self, style=None):
+        prefill=[]; generation=[]
+        def generate(**kwargs):
+            generation.append(kwargs)
+            yield None,'回答'
+        engine=MiniCPMEngine.__new__(MiniCPMEngine)
+        engine.torch=SimpleNamespace(inference_mode=nullcontext)
+        engine.model=SimpleNamespace(reset_session=lambda **kw:None,
+            init_streaming_processor=lambda:None,
+            streaming_prefill=lambda **kw:prefill.extend(kw['msgs']),streaming_generate=generate)
+        if style is not None:engine.reply_style=style
+        list(engine.generate([{'role':'user','content':['请解释原因']}],SimpleNamespace(is_set=lambda:False)))
+        return prefill[0]['content'][0],generation[0]
+
+    def test_default_retains_current_concise_policy(self):
+        prompt,params=self.capture()
+        self.assertEqual(prompt,SYSTEM)
+        self.assertEqual(params['max_new_tokens'],128)
+
+    def test_balanced_reaches_model_with_larger_bounded_budget(self):
+        prompt,params=self.capture('balanced')
+        self.assertNotIn('60字',prompt)
+        self.assertIn('结论',prompt)
+        self.assertIn('理由',prompt)
+        self.assertEqual(params['max_new_tokens'],192)
+
+    def test_invalid_style_rejected_before_loading(self):
+        with self.assertRaises(ValueError):
+            MiniCPMEngine('/missing/model',reply_style='unbounded')
+
+    async def test_health_reports_selected_style(self):
+        engine=SimpleNamespace(reply_style='balanced')
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app=create_app(engine)),base_url='http://test') as client:
+            self.assertEqual((await client.get('/health')).json()['capabilities']['reply_style'],'balanced')
